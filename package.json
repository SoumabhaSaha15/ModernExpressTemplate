{
  "name": "ModernExpressTemplate",
  "version": "1.0.0",
  "description": "A modern Express.js template for Node.js 22+ and TypeScript 6+ precongigured with ESLint, and mongodb-mongoose dotenv, and more.",
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --inspect src/index.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "build": "tsc && tsc-alias --resolve-full-paths",
    "clear": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "imports": {
    "#/*": "./dist/*"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@t3-oss/env-core": "^0.13.11",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-zod-safe": "^3.2.1",
    "mongodb": "^7.7.0",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "swagger-themes": "^1.4.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
